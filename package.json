{
  "name": "devtoolkit",
  "private": true,
  "version": "0.1.0",
  "description": "DevToolkit - self-hosted, offline-grade developer utilities. All processing local, zero data egress.",
  "type": "module",
  "license": "MIT",
  "author": "Sandeep Lokhande",
  "repository": "github:SandyGitRepo/DevTools",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/copy-pdfjs-assets.mjs && tsc --noEmit -p . && vite build",
    "start": "node server/server.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "licenses": "node scripts/check-licenses.mjs",
    "package": "node scripts/package.mjs",
    "release": "npm run lint && npm run typecheck && npm test && npm run licenses && npm run build && node scripts/package.mjs",
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "test:all": "node scripts/test-all.mjs",
    "test:security": "node tests/e2e/security.mjs",
    "test:nfr": "node tests/e2e/nonfunctional.mjs"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@faker-js/faker": "^10.6.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "asn1js": "^3.0.10",
    "base-x": "^5.0.1",
    "change-case": "^5.4.4",
    "cron-parser": "^5.10.1",
    "cronstrue": "^3.27.0",
    "dompurify": "^3.4.16",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "framer-motion": "^14.0.0",
    "hash-wasm": "^4.12.0",
    "he": "^2.0.0",
    "jose": "^6.2.12",
    "js-yaml": "^5.4.2",
    "jsondiffpatch": "^0.7.6",
    "jsonpath-plus": "^11.1.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.52.0",
    "marked": "^18.0.14",
    "minisearch": "^7.2.0",
    "monaco-editor": "^0.57.0",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "pkijs": "^3.4.1",
    "prettier": "^3.9.9",
    "prettier-plugin-java": "^2.11.0",
    "prismjs": "^1.30.0",
    "qrcode": "^1.5.4",
    "quicktype-core": "^26.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "sql-formatter": "^15.9.0",
    "terser": "^5.51.2",
    "uuid": "^14.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xml-formatter": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/he": "^1.2.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.4",
    "@types/papaparse": "^5.5.2",
    "@types/prismjs": "^1.26.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "dompurify": "$dompurify"
  }
}
